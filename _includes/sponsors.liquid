{% comment %}
  Homepage sponsor / collaborator marquee.

  Logos, order, and current/past status live in _data/sponsors.yml.
  The track is rendered twice so the CSS animation can loop seamlessly
  (translateX(-50%) returns to an identical starting frame). The second
  copy is aria-hidden so screen readers and search engines see each
  sponsor only once.
{% endcomment %}

<section class="sponsors-marquee" aria-label="Sponsors and collaborators">
  <p class="sponsors-marquee__label">Thanks to our sponsors &amp; collaborators</p>

  <div class="sponsors-marquee__viewport">
    <div class="sponsors-marquee__track">
      {% for pass in (1..2) %}
        {% for sponsor in site.data.sponsors %}
          {% assign logo_url = sponsor.logo | prepend: '/assets/img/logos/' | relative_url %}
          <div class="sponsors-marquee__item"{% if pass == 2 %} aria-hidden="true"{% endif %}>
            <img
              class="sponsors-marquee__img"
              src="{{ logo_url }}"
              alt="{{ sponsor.name | escape }}"
              title="{{ sponsor.name | escape }}"
              loading="eager"
            >
          </div>
        {% endfor %}
      {% endfor %}
    </div>
  </div>
</section>
