@article{chammas2026high,
  title={High-resolution simulations reveal positive global warming feedback from Pacific low clouds},
  author={Chammas, S. and Wang, M. and Schneider, T. and Carver, R. W. and Shen, Z. and Parker, J. B. and Gazen, C. and Ihme, M. and Chen, Y.-F. and Anderson, J.},
  journal={Science Advances},
  volume={12},
