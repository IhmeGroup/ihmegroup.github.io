@article{li2023analysis,
  title={Analysis of real-fluid thermodynamic effects on turbulent statistics in transcritical channel flows},
  author={Li, F. and Guo, J. and Bai, B. and Ihme, M.},
  journal={Physical Review Fluids},
  volume={8},
  number={2},
  year={2023},
  doi={10.1103/physrevfluids.8.024605},
  open_access_url={https://www.osti.gov/servlets/purl/1993712},
  abstract={High-pressure transcritical turbulence with strong density fluctuations are encountered in many technical applications. Understanding of the turbulent energy transport modulated by real-fluid thermodynamic effects at transcritical conditions remains an open issue for developing reliable computational models. We clarify the effects of real-fluid thermodynamics through budget analyses of turbulent kinetic energy and dissipation rate from DNS of transcritical channel flows. From this physical underpinning, new scaling laws for turbulent length scales and turbulent kinetic energy budgets are proposed, thereby contributing to improvements of wall-models for LES and RANS simulations.},
}

