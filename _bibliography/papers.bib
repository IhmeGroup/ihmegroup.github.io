@article{tonicello2024generalisation,
  title={Generalisation of the Spectral Difference scheme for the diffused-interface five equation model},
  author={Tonicello, N. and Lodato, G. and Ihme, M.},
  journal={arXiv (Cornell University)},
  year={2024},
  doi={10.48550/arxiv.2403.19623},
  open_access_url={https://arxiv.org/pdf/2403.19623},
  abstract={The present work focuses on the generalisation of the Spectral Difference (SD) scheme to the reduced Baer-Nunziato system known as five-equation model for the simulation of two immiscible compressible fluids. This five equation model is considered with the additional Allen-Cahn regularisation to avoid both over-diffusion and over-thinning of the phase field representing the interface. Finally, in order to preserve contact discontinuities, in the reconstruction step of the spectral difference scheme, a change of variables from conservative to primitive is used. This approach is shown to be beneficial in avoiding pressure oscillations at material interfaces. An extensive series of numerical tests are proposed to assess accuracy and robustness of the present method. Both kinematic (Rider-Kothe vortex) and two-phase flow problems (Rayleigh-Taylor instability, shock-droplet interaction, Taylor-Green vortex) are considered.},
}

@article{tpperwien2024effect,
  title={Effect of Burn Parameters on PAH Emissions at Conditions Relevant for Prescribed Fires},
  author={T{\"o}pperwien, K. and Vignat, G. and Feinberg, A. J. and Daube, C. and Alton, M. W. and Fortner, E. C. and Canagaratna, M. R. and Kling, M. F. and Johnson, M. and Nadeau, K. C. and Herndon, S. C. and Jayne, J. T. and Ihme, M.},
  journal={arXiv (Cornell University)},
  year={2024},
  doi={10.48550/arxiv.2407.01944},
  open_access_url={https://arxiv.org/pdf/2407.01944},
  abstract={Wildfire smoke is a health hazard as it contains a mixture of carcinogenic volatile compounds and fine particulate matter. In particular, exposure to polycyclic aromatic hydrocarbons (PAHs) is a major concern, since these compounds have been recognized as important contributors to the overall carcinogenic risk of smoke exposure. In this work, gas and particle-phase PAH emissions from the combustion of Eastern White Pine (pinus strobus) were quantified using time-of-flight mass spectrometry over a range of burn conditions representative of wildfires and prescribed fires. These experiments allow for controlling conditions of fuel moisture, heat flux, and oxygen concentration to understand their impact on PAH emissions. We find that optimal conditions for fuel moisture content of 20 - 30%, heat load onto the sample of 60 - 70 kW/m$^2$, and oxygen concentrations of the burn environment of 5 - 15% can reduce the emissions of the heavy molar weight PAHs by up to 77%. Our analysis shows that the relative carcinogenic risk can be reduced by more than 50% under optimal conditions, offering a way for reducing emission exposure from forest treatment activities.},
}

@article{boign2024turbulence,
  title={Turbulence in disguise: Reactive flows in porous media mimic turbulent behavior},
  author={Boign{\'e}, {\'E}. and Sobhani, S. and Ferguson, J. C. and Ihme, M.},
  journal={Physical Review Fluids},
  volume={9},
  number={10},
  year={2024},
  doi={10.1103/physrevfluids.9.l101201},
  abstract={Chemically reacting flows through porous media are widespread in biological, environmental, and engineering applications. Yet, understanding these flows remains an outstanding challenging. This letter reveals that hydrodynamic dispersion affects reaction fronts in ways analogous to free turbulence. Our findings thus point to a regime diagram that elucidates the pore-scale coupling between fundamental processes, offering valuable theoretical insights into these complex flows.},
}

